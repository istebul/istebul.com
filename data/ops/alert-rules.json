{
  "version": "p12.0",
  "window": "24h",
  "rules": [
    {
      "id": "ops_critical_events",
      "domain": "operations",
      "severity": "critical",
      "metric": "ops.criticalCount",
      "op": "gte",
      "threshold": 1,
      "message": "Critical operational events in last 24h — check Observability and Stripe/partner webhooks."
    },
    {
      "id": "ops_error_spike",
      "domain": "operations",
      "severity": "error",
      "metric": "ops.errorCount",
      "op": "gte",
      "threshold": 10,
      "message": "Error event spike (≥10/24h) — review ops_health rollup."
    },
    {
      "id": "partner_dispatch_fails",
      "domain": "partner",
      "severity": "warning",
      "metric": "partner.webhookFailCount",
      "op": "gte",
      "threshold": 5,
      "message": "Partner webhook/dispatch failures elevated — run partner-retry workflow."
    },
    {
      "id": "partner_dispatch_rate_low",
      "domain": "partner",
      "severity": "warning",
      "metric": "partner.dispatchRatePct",
      "op": "lt",
      "threshold": 70,
      "message": "Lead dispatch success rate below 70% — check partner endpoints and HMAC secrets."
    },
    {
      "id": "partner_sla_p95_breach",
      "domain": "partner",
      "severity": "warning",
      "metric": "partner.dispatchP95Ms",
      "op": "gt",
      "threshold": 900000,
      "message": "Partner dispatch p95 latency exceeds 15m SLA — review endpoint latency and circuit breakers."
    },
    {
      "id": "partner_retry_backlog",
      "domain": "partner",
      "severity": "warning",
      "metric": "partner.retryDueNow",
      "op": "gte",
      "threshold": 8,
      "message": "Large dispatch_failed retry backlog — confirm partner-retry workflow is running."
    },
    {
      "id": "partner_webhook_unhealthy",
      "domain": "partner",
      "severity": "error",
      "metric": "partner.unhealthyEndpointCount",
      "op": "gte",
      "threshold": 1,
      "message": "Partner endpoint marked unhealthy — verify webhook URL and HMAC secret."
    },
    {
      "id": "partner_circuit_open",
      "domain": "partner",
      "severity": "warning",
      "metric": "partner.circuitOpenCount",
      "op": "gte",
      "threshold": 1,
      "message": "Partner circuit breaker open — failover or manual endpoint reset required."
    },
    {
      "id": "partner_inactive_endpoints",
      "domain": "partner",
      "severity": "info",
      "metric": "partner.inactiveEndpointCount",
      "op": "gte",
      "threshold": 1,
      "message": "Active partner endpoint(s) with no successful dispatch in 7d — partner inactivity."
    },
    {
      "id": "partner_dispatch_dead",
      "domain": "partner",
      "severity": "error",
      "metric": "partner.dispatchDeadCount",
      "op": "gte",
      "threshold": 3,
      "message": "Multiple leads reached dispatch_dead after max retries — manual partner ops required."
    },
    {
      "id": "revenue_churn_signal",
      "domain": "revenue",
      "severity": "warning",
      "metric": "revenue.cancelAtPeriodEnd",
      "op": "gte",
      "threshold": 3,
      "message": "Multiple subscriptions set to cancel at period end — retention outreach."
    },
    {
      "id": "revenue_checkout_abandon",
      "domain": "revenue",
      "severity": "info",
      "metric": "revenue.checkoutAbandonEvents",
      "op": "gte",
      "threshold": 20,
      "message": "Checkout abandon volume high — confirm lifecycle checkout_abandon_recovery enrollments."
    },
    {
      "id": "lifecycle_stalled",
      "domain": "lifecycle",
      "severity": "warning",
      "metric": "lifecycle.failedMessages",
      "op": "gte",
      "threshold": 5,
      "message": "Lifecycle message failures — verify email provider and lifecycle-cron."
    },
    {
      "id": "analytics_sample_cap",
      "domain": "analytics",
      "severity": "info",
      "metric": "analytics.eventsAtCap",
      "op": "eq",
      "threshold": 1,
      "message": "Analytics export hit row cap — warehouse upgrade recommended for Series A diligence."
    },
    {
      "id": "ai_rate_limit_pressure",
      "domain": "ai",
      "severity": "info",
      "metric": "ai.proxyRateLimitHits",
      "op": "gte",
      "threshold": 15,
      "message": "AI proxy rate-limit pressure — review Groq quota and session caps."
    }
  ]
}

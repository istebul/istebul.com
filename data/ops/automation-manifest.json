{
  "version": "p9.0",
  "updatedAt": "2026-05-24",
  "mission": "Run isteBul as an automation-first digital company with scheduled rollups, threshold alerts, and a single ops command center.",
  "scheduledJobs": [
    {
      "id": "lifecycle_cron",
      "cadence": "hourly",
      "workflow": ".github/workflows/lifecycle-cron.yml",
      "handler": "supabase/functions/lifecycle-cron",
      "domains": ["customer", "lifecycle", "revenue"]
    },
    {
      "id": "partner_retry",
      "cadence": "every_15m",
      "workflow": ".github/workflows/partner-retry.yml",
      "handler": "supabase/functions/partner-retry",
      "domains": ["partner"]
    },
    {
      "id": "partner_ops_monitor",
      "cadence": "every_15m",
      "workflow": ".github/workflows/partner-ops-monitor.yml",
      "script": "scripts/partner-ops-automation-run.cjs",
      "domains": ["partner", "operations"]
    },
    {
      "id": "ceo_alerts",
      "cadence": "hourly",
      "workflow": ".github/workflows/ceo-alerts.yml",
      "script": "scripts/ceo-alert-run.cjs",
      "domains": ["revenue", "conversion", "partner", "analytics", "growth"]
    },
    {
      "id": "ops_automation",
      "cadence": "daily_06_utc",
      "workflow": ".github/workflows/ops-automation.yml",
      "script": "scripts/ops-automation-run.cjs",
      "domains": ["operations", "analytics", "revenue", "partner", "lifecycle"]
    },
    {
      "id": "production_deploy",
      "cadence": "on_push_main",
      "workflow": ".github/workflows/production-deploy.yml",
      "domains": ["operations"]
    }
  ],
  "snapshotScripts": [

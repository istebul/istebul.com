{
  "version": "p7.0",
  "headline": "Instrumented hybrid revenue — every slide ties to a query",
  "northStar": {
    "primary": "qualified_leads_per_week",
    "secondary": ["pro_mrr_try", "partner_actual_revenue_try", "blended_arr_try"]
  },

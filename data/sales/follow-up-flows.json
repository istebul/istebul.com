{
  "version": "p6.1",
  "flows": [
    {
      "id": "ae_new_application",
      "name": "Yeni başvuru → ilk temas",
      "trigger": { "applicationStatus": "new", "maxHours": 4 },
      "steps": [
        { "day": 0, "action": "email", "templateId": "discover_intro", "crmTouch": "outbound_email" },
        { "day": 0, "action": "linkedin", "sequenceId": "partner_linkedin_touch", "crmTouch": "outbound_linkedin" },
        { "day": 1, "action": "call", "note": "Keşif 15 dk — deck gönderildi mi?", "crmTouch": "discovery_call" },
        { "day": 3, "action": "email", "sequenceId": "partner_cold_outbound", "stepId": "d3_followup" }
      ],
      "onSuccess": { "status": "contacted" },
      "lifecycleFlow": "partner_sales_cadence"
    },
    {
      "id": "ae_qualified_close",
      "name": "Uygun → teklif kapanışı",
      "trigger": { "applicationStatus": "qualified" },
      "steps": [
        { "day": 0, "action": "email", "templateId": "proposal_send", "crmTouch": "proposal_sent" },
        { "day": 2, "action": "call", "note": "Fiyat/itiraz — pricing sheet", "crmTouch": "follow_up" },
        { "day": 5, "action": "email", "sequenceId": "partner_cold_outbound", "stepId": "d7_close" },
        { "day": 7, "action": "email", "templateId": "close_contract", "crmTouch": "proposal_sent" }
      ],
      "onSuccess": { "status": "integrating" }
    },
    {
      "id": "ae_integrating_velocity",
      "name": "Entegrasyon hızlandırma",
      "trigger": { "applicationStatus": "integrating", "velocityHealth": ["stuck", "overdue"] },
      "steps": [
        { "day": 0, "action": "email", "sequenceId": "stalled_onboarding", "stepId": "nudge" },
        { "day": 1, "action": "email", "docId": "kickoff", "crmTouch": "follow_up" },
        { "day": 2, "action": "call", "note": "Webhook test durumu", "crmTouch": "follow_up" }
      ],
      "onSuccess": { "status": "integrating" }
    },
    {
      "id": "ae_live_expand",
      "name": "Canlı → upsell",
      "trigger": { "applicationStatus": "live", "minDaysLive": 30 },
      "steps": [
        { "day": 0, "action": "email", "templateId": "live_welcome", "crmTouch": "follow_up" },
        { "day": 14, "action": "call", "note": "Growth kapasite / ikinci endpoint", "crmTouch": "demo" }
      ],
      "onSuccess": { "status": "live" }
    },
    {
      "id": "ae_rejected_nurture",
      "name": "Red → 90g nurture",
      "trigger": { "applicationStatus": "rejected" },
      "steps": [
        { "day": 30, "action": "email", "templateId": "discover_intro", "crmTouch": "outbound_email" },
        { "day": 90, "action": "email", "sequenceId": "partner_cold_outbound", "stepId": "d0_intro" }
      ]
    }
  ]
}

{
  "name": "istebu-v2",
  "version": "2.0.0",
  "description": "Modern Turkish marketplace platform - isteBu v2",
  "main": "js/app.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "npm run check && node scripts/production-build.js",
    "deploy": "npx netlify-cli deploy --prod",
    "check": "node scripts/check-syntax.js && node scripts/check-console.js",
    "assets:generate": "node scripts/generate-assets.js",
    "lint": "eslint . --ext .js",
    "coverage": "SUPABASE_URL=http://localhost SUPABASE_ANON_KEY=test node --no-warnings --test --experimental-test-coverage tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "test": "npm run lint && npm run check && npm run test:unit && npm run test:integration && npm run test:smoke && npm run test:accessibility && npm run test:performance",
    "test:unit": "SUPABASE_URL=http://localhost SUPABASE_ANON_KEY=test node --no-warnings --test tests/unit/*.test.mjs",
    "test:integration": "node --no-warnings --test tests/integration/*.test.mjs",
    "test:smoke": "SUPABASE_URL=http://localhost SUPABASE_ANON_KEY=test node --no-warnings scripts/smoke-test.js",
    "test:accessibility": "node scripts/accessibility-check.js",
    "test:performance": "node scripts/performance-check.js",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install",
    "lhci": "lhci autorun",
    "analyze:bundle": "node scripts/production-build.js && node scripts/analyze-bundle.js",
    "build:check": "node scripts/check-build-output.js"
  },
  "keywords": [
    "marketplace",
    "turkish",
    "supabase",
    "netlify"
  ],
  "author": "isteBu Team",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.0.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.13.0",
    "@playwright/test": "^1.44.0",
    "esbuild": "^0.19.11",
    "eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

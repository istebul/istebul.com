# Cloudflare Pages routing — static assets BEFORE SPA fallback.
# CF applies redirects before static lookup; passthrough rules preserve real MIME types.

# --- Static asset passthrough (do not rewrite to index.html) ---
/css/*       /css/:splat       200
/js/*        /js/:splat        200
/assets/*    /assets/:splat    200
/images/*    /images/:splat    200
/fonts/*     /fonts/:splat     200
/data/*      /data/:splat      200
/docs/*      /docs/:splat      200
/env.js      /env.js           200
/sw.js       /sw.js            200
/manifest.json /manifest.json  200
/importmap.json /importmap.json 200
/robots.txt  /robots.txt       200
/sitemap.xml /sitemap.xml      200
/build-manifest.json /build-manifest.json 200
/offline.html /offline.html   200
/favicon.ico /favicon.ico     200


# Environment Configuration Template
# Copy this file to .env.local and fill in your actual values

# Supabase Configuration (REQUIRED)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Claude AI Integration (Optional)
CLAUDE_API_KEY=your-claude-api-key-here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# AI Proxy (Cloudflare Pages Functions — server-side only)
# Default provider: groq. Leave AI_PROVIDER unset or set it to groq for the current production default.
AI_PROVIDER=groq

# Required when AI_PROVIDER is unset or groq.
GROQ_API_KEY=

# Required only when AI_PROVIDER=openai.
OPENAI_API_KEY=

# Optional OpenAI model override. Default in runtime: gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Optional extra protection for /ai-proxy POST calls.
AI_PROXY_TOKEN=

# Monitoring (Optional - for production use Sentry or LogRocket)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
LOGROCKET_APP_ID=your-logrocket-app-id

# Analytics (Optional)
PLAUSIBLE_DOMAIN=istebul.com

# Security (production — set in Cloudflare Pages / Supabase secrets)
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRICE_ID=price_monthly_...
STRIPE_PRICE_ID_ANNUAL=price_annual_...
STRIPE_TRIAL_DAYS=7
TURNSTILE_SECRET=...
LEAD_ALERT_WEBHOOK_SECRET=generate-a-long-random-secret
REFERRAL_WEBHOOK_SECRET=generate-a-long-random-secret
PAID_CONVERSION_SECRET=generate-a-long-random-secret
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
GOOGLE_ADS_CONVERSION_ACTION_ID=
LIFECYCLE_WEBHOOK_SECRET=generate-a-long-random-secret
PARTNER_CALLBACK_SECRET=...
RETRY_WORKER_SECRET=...

# GarsonAI — Restoran keşif modülü (isteBul API gateway; varsayılan https://api.istebul.com)
# GARSONAI_API_URL=https://api.istebul.com
# VITE_GARSONAI_API_URL=https://api.istebul.com

# Development Server
HOST=127.0.0.1
PORT=3000
NODE_ENV=development

# Environment Configuration Template
# Copy this file to .env.local and fill in your actual values

# Supabase Configuration (REQUIRED)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Claude AI Integration (Optional)
CLAUDE_API_KEY=your-claude-api-key-here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Monitoring (Optional - for production use Sentry or LogRocket)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
LOGROCKET_APP_ID=your-logrocket-app-id

# Analytics (Optional)
PLAUSIBLE_DOMAIN=istebul.com

# Security (production — set in Netlify / Supabase secrets)
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRICE_ID=price_...
TURNSTILE_SECRET=...
LEAD_ALERT_WEBHOOK_SECRET=generate-a-long-random-secret
AI_PROXY_TOKEN=optional-extra-token-for-ai-proxy
PARTNER_CALLBACK_SECRET=...
RETRY_WORKER_SECRET=...

# Deployment (GitHub Actions + Netlify)
NETLIFY_AUTH_TOKEN=your-netlify-personal-access-token
NETLIFY_SITE_ID=your-netlify-site-id

# Development Server
HOST=127.0.0.1
PORT=3000
NODE_ENV=development

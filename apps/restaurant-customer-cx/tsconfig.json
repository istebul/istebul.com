{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@istebul/ai-concierge": ["../../src/ai-concierge/index.ts"],
      "@istebul/ai-core": ["../../src/ai-core/index.ts"],
      "@istebul/restaurant-knowledge": ["../../src/restaurant-knowledge/index.ts"]
    }
  },
  "include": ["src"]
}


